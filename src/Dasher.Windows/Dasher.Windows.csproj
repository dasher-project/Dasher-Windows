<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.18362.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>dasher.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <VersionPrefix>0.1.0</VersionPrefix>
    <InformationalVersion Condition="'$(ReleaseVersion)' != ''">$(ReleaseVersion)</InformationalVersion>
    <InformationalVersion Condition="'$(ReleaseVersion)' == ''">$(VersionPrefix)-dev</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <Content Include="dasher.dll" CopyToOutputDirectory="PreserveNewest" />
    <AvaloniaResource Include="dasher.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageReference Include="DotNetTtsWrapper" Version="1.1.6" />
    <PackageReference Include="eyetuitive.NET" Version="1.7.1" />
    <PackageReference Include="Lucide.Avalonia" Version="0.2.10" />
    <PackageReference Include="PostHog" Version="2.7.1" />
    <PackageReference Include="System.Speech" Version="10.0.9" />
  </ItemGroup>

  <Target Name="CopyTobiiDll" AfterTargets="Build;Publish">
    <Copy SourceFiles="native\tobii_stream_engine.dll"
          DestinationFolder="$(OutputPath)"
          Condition="Exists('native\tobii_stream_engine.dll')" />
    <Copy SourceFiles="native\tobii_stream_engine.dll"
          DestinationFolder="$(PublishDir)"
          Condition="Exists('native\tobii_stream_engine.dll') And '$(PublishDir)' != ''" />
  </Target>

  <!-- i18n: regenerate Resources/Strings*.resx from the shared catalogue
       (shared-resources/ui-strings.json) whenever the catalogue is newer.
       Incremental via Inputs/Outputs; best-effort — warns (not errors) when
       Python is unavailable, so machines without it still build. CI additionally
       verifies the committed files are fresh. -->
  <PropertyGroup>
    <SharedCatalogue>$(MSBuildThisFileDirectory)..\..\shared-resources\ui-strings.json</SharedCatalogue>
    <GenTranslationsScript>$(MSBuildThisFileDirectory)..\..\Scripts\gen-translations.py</GenTranslationsScript>
  </PropertyGroup>
  <Target Name="GenerateStringsResx"
          Inputs="$(SharedCatalogue)"
          Outputs="$(MSBuildThisFileDirectory)Resources\Strings.resx"
          BeforeTargets="BeforeBuild">
    <Warning Text="shared-resources submodule missing — run 'git submodule update --init' to localise UI strings."
             Condition="!Exists('$(SharedCatalogue)')" />
    <Exec Command="python -X utf8 &quot;$(GenTranslationsScript)&quot; || py -3 -X utf8 &quot;$(GenTranslationsScript)&quot;"
          Condition="Exists('$(SharedCatalogue)')"
          ContinueOnError="WarnAndContinue" />
  </Target>
</Project>
